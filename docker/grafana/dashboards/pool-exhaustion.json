{
  "dashboard": {
    "id": null,
    "uid": "pg-pool-exhaustion",
    "title": "Postgres Pool Exhaustion Lab",
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "5s",
    "time": {
      "from": "now-10m",
      "to": "now"
    },
    "panels": [
      {
        "type": "stat",
        "title": "DB Backends vs max_connections",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "sum(pg_stat_activity_count{datname=\"app\"}) by (state)",
            "legendFormat": "{{state}}",
            "refId": "A"
          },
          {
            "expr": "pg_settings_max_connections",
            "legendFormat": "max_connections",
            "refId": "B"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "horizontal",
          "textMode": "value",
          "colorMode": "value"
        }
      },
      {
        "type": "stat",
        "title": "PgBouncer Server Connections",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "pgbouncer_pools_server_active_connections{database=\"app\"}",
            "legendFormat": "sv_active",
            "refId": "A"
          },
          {
            "expr": "pgbouncer_pools_server_idle_connections{database=\"app\"}",
            "legendFormat": "sv_idle",
            "refId": "B"
          },
          {
            "expr": "pgbouncer_pools_client_active_connections{database=\"app\"}",
            "legendFormat": "cl_active",
            "refId": "C"
          },
          {
            "expr": "pgbouncer_pools_client_waiting_connections{database=\"app\"}",
            "legendFormat": "cl_waiting",
            "refId": "D"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "horizontal",
          "textMode": "value",
          "colorMode": "value"
        }
      },
      {
        "type": "timeseries",
        "title": "App Pool: Total / Idle / Waiting",
        "gridPos": { "x": 0, "y": 6, "w": 24, "h": 7 },
        "targets": [
          {
            "expr": "db_pool_total",
            "legendFormat": "{{replica}} total",
            "refId": "A"
          },
          {
            "expr": "db_pool_idle",
            "legendFormat": "{{replica}} idle",
            "refId": "B"
          },
          {
            "expr": "db_pool_waiting",
            "legendFormat": "{{replica}} waiting",
            "refId": "C"
          }
        ],
        "options": {
          "legend": { "displayMode": "list", "placement": "right" },
          "tooltip": { "mode": "multi" }
        }
      },
      {
        "type": "timeseries",
        "title": "HTTP p95 Latency",
        "gridPos": { "x": 0, "y": 13, "w": 12, "h": 7 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))",
            "legendFormat": "p95",
            "refId": "A"
          }
        ],
        "options": {
          "legend": { "displayMode": "list", "placement": "right" },
          "tooltip": { "mode": "multi" }
        }
      },
      {
        "type": "timeseries",
        "title": "5xx Error Rate",
        "gridPos": { "x": 12, "y": 13, "w": 12, "h": 7 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m])) / sum(rate(http_requests_total[1m]))",
            "legendFormat": "5xx rate",
            "refId": "A"
          }
        ],
        "options": {
          "legend": { "displayMode": "list", "placement": "right" },
          "tooltip": { "mode": "multi" }
        }
      },
      {
        "type": "timeseries",
        "title": "DB Errors by Reason",
        "gridPos": { "x": 0, "y": 20, "w": 12, "h": 7 },
        "targets": [
          {
            "expr": "sum by (reason) (rate(pg_pool_errors_total[1m]))",
            "legendFormat": "{{reason}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": { "displayMode": "list", "placement": "right" },
          "tooltip": { "mode": "multi" }
        }
      },
      {
        "type": "timeseries",
        "title": "PgBouncer Queue & Wait",
        "gridPos": { "x": 12, "y": 20, "w": 12, "h": 7 },
        "targets": [
          {
            "expr": "pgbouncer_pools_client_waiting_connections{database=\"app\"}",
            "legendFormat": "cl_waiting",
            "refId": "A"
          },
          {
            "expr": "pgbouncer_pools_client_maxwait_seconds{database=\"app\"}",
            "legendFormat": "maxwait_s",
            "refId": "B"
          }
        ],
        "options": {
          "legend": { "displayMode": "list", "placement": "right" },
          "tooltip": { "mode": "multi" }
        }
      },
      {
        "type": "timeseries",
        "title": "k6 Requests & Failures",
        "gridPos": { "x": 0, "y": 27, "w": 24, "h": 7 },
        "targets": [
          {
            "expr": "rate(k6_http_reqs_total[1m])",
            "legendFormat": "reqs/s",
            "refId": "A"
          },
          {
            "expr": "k6_http_req_failed_rate",
            "legendFormat": "failed rate",
            "refId": "B"
          }
        ],
        "options": {
          "legend": { "displayMode": "list", "placement": "right" },
          "tooltip": { "mode": "multi" }
        }
      }
    ],
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    }
  },
  "overwrite": true
}
